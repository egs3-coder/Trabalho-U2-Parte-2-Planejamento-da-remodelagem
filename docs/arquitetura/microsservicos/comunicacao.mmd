  REQ --- DB1[("PostgreSQL requisicao")]
  EST --- DB2[("PostgreSQL estoque")]
  EXP --- DB3[("PostgreSQL expedicao")]
  TRA --- DB4[("Séries temporais\ntelemetria")]
